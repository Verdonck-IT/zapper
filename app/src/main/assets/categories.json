  "rules": [
    { "_doc": "Misdaad in een docu = true crime, niet in de fictierij",
      "when": ["crime", "docu"], "add": ["truecrime"], "remove": ["crime"] },
    { "_doc": "Crime- en comedyreeksen niet dubbel in de algemene fictierij",
      "when": ["drama", "crime"], "remove": ["drama"] },
    { "when": ["drama", "comedy"], "remove": ["drama"] },
    { "_doc": "Een quiz is geen reality",
      "when": ["games", "reality"], "remove": ["reality"] },
    { "_doc": "Kinderinhoud nooit in volwassen rijen",
      "when": ["kids"], "keepOnly": ["kids", "live"] },
    { "_doc": "Nieuws is geen fictie, ook al valt het woord 'moord'",
      "when": ["news"], "remove": ["crime", "drama"] }
  ]
}
