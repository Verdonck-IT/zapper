  "keywords": {
    "crime": ["moord", "rechercheur", "recherche", "speurder", "detective", "thriller", "misdaad", "commissaris", "onderzoeksrechter", "seriemoordenaar"],
    "comedy": ["komedie", "sitcom", "sketch", "humor", "comedy", "satire"],
    "games": ["quiz", "spelprogramma", "kandidaten strijden", "kandidaten nemen het op", "spelshow"],
    "reality": ["realityreeks", "datingshow", "dating", "verliefd", "koppels", "op zoek naar de liefde", "realityprogramma"],
    "docu": ["documentaire", "docureeks", "getuigenissen", "portret"],
    "talk": ["talkshow", "late night", "praatprogramma", "gasten aan tafel"],
    "music": ["concert", "zanger", "zangeres", "muzikanten", "festival", "optreden"],
    "lifestyle": ["recept", "recepten", "koken", "chef", "verbouwing", "renovatie", "interieur", "tuin", "huis kopen"],
    "nature": ["natuur", "dieren", "wetenschap", "planeet", "klimaat", "oceaan"],
