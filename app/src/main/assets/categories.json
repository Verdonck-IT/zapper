      "thema-reality": ["reality"], "thema-lifestyle": ["lifestyle"], "thema-music": ["music"], "thema-sport": ["sport"],
      "thema-news": ["news"], "thema-archive": ["archive"], "thema-kids": ["kids"], "thema-docu": ["docu"], "thema-films": ["films"]
    },
    "focuswtv": {}
